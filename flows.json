        "id": "935004e5c404a7e2",
        "type": "function",
        "z": "3b9534016f669eca",
        "name": "CSV Logger ",
        "func": "let weight = Number(msg.payload);\nif (isNaN(weight)) return null;\n\nmsg.payload = {\n    date: new Date().toLocaleDateString(),\n    time: new Date().toLocaleTimeString(),\n    weight: weight,\n    dailyTotal: flow.get(\"dailyTotal\") || 0,\n    bagCount: flow.get(\"bagCount\") || 0,\n    event: \"weight_update\"\n};\n\nreturn msg;\n",
        "outputs": 1,
