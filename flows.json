    {
        "id": "b487deaccb32b34d",
        "type": "function",
        "z": "3b9534016f669eca",
        "d": true,
        "name": "Clean Weight",
        "func": "let raw = msg.payload.toString();\n\nlet match = raw.match(/-?\\d+(\\.\\d+)?/);\nif (!match) return null;\n\nlet weight = parseFloat(match[0]);\n\nlet minChange = 0.10;\nlet stableDelay = 1500;\n\nlet lastWeight = context.get(\"lastWeight\");\nlet lastTime = context.get(\"lastTime\") || 0;\nlet now = Date.now();\n\nif (lastWeight !== undefined) {\n    let diff = Math.abs(weight - lastWeight);\n\n    if (diff < minChange) return null;\n    if (now - lastTime < stableDelay) return null;\n}\n\ncontext.set(\"lastWeight\", weight);\ncontext.set(\"lastTime\", now);\n\nmsg.payload = weight;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 120,
        "wires": [
            [
                "569df630674c34f9",
                "8ef5b70f03b4f687",
                "c4c7b42dd424f471"
            ]
        ]
    },
