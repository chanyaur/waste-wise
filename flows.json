        "name": "UI - Today's Waste",
        "order": 2,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n    <div class=\"weight-card\">\n        <div class=\"weight-header\">\n            <span class=\"weight-title\">CURRENT FOOD WASTE</span>\n            <span class=\"live-status\">\n                <span class=\"live-dot\"></span>\n                LIVE\n            </span>\n        </div>\n\n        <div class=\"weight-reading\">\n            {{ msg?.payload ?? \"0.00\" }}\n            <span class=\"weight-unit\">lb</span>\n        </div>\n\n        <div class=\"weight-subtitle\">\n            Cafeteria Scale\n        </div>\n    </div>\n</template>\n\n<style>\n.weight-card {\n    width: 100%;\n    min-height: 230px;\n    padding: 28px 32px;\n    border-radius: 24px;\n    background: linear-gradient(145deg, #ffffff, #f5f7fa);\n    box-shadow:\n        0 12px 30px rgba(0,0,0,0.08),\n        inset 0 1px 0 rgba(255,255,255,0.8);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    box-sizing: border-box;\n}\n\n.weight-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.weight-title {\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    opacity: 0.55;\n}\n\n.live-status {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    opacity: 0.7;\n}\n\n.live-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #32c76f;\n    box-shadow: 0 0 0 5px rgba(50,199,111,0.13);\n}\n\n.weight-reading {\n    text-align: center;\n    font-size: clamp(58px, 8vw, 92px);\n    font-weight: 750;\n    letter-spacing: -4px;\n    line-height: 1;\n    margin: 25px 0 15px;\n}\n\n.weight-unit {\n    font-size: 24px;\n    font-weight: 600;\n    letter-spacing: 0;\n    opacity: 0.45;\n    margin-left: 8px;\n}\n\n.weight-subtitle {\n    text-align: center;\n    font-size: 13px;\n    opacity: 0.45;\n}\n</style>",
