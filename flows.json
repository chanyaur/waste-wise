    {
        "id": "569df630674c34f9",
        "type": "function",
        "z": "3b9534016f669eca",
        "name": "Add Daily Total ",
        "func": "let weight = Number(msg.payload);\nif (isNaN(weight)) return null;\n\n// ==========================\n// SETTINGS\n// ==========================\n\n// A drop this large means a bag is probably being removed\nlet minDump = 0.2;          // kg\n\n// Readings within this amount count as \"stable\"\nlet stableTolerance = 0.10; // kg\n\n// Number of consecutive stable readings required\nlet stableReadingsNeeded = 2;\n\n\n// ==========================\n// GET STORED VALUES\n// ==========================\n\nlet lastWeight = flow.get(\"lastWeight\");\nlet savedTotal = flow.get(\"savedTotal\") || 0;\n\nlet changingBag = flow.get(\"changingBag\") || false;\nlet oldBagWeight = flow.get(\"oldBagWeight\") || 0;\n\nlet stableCount = flow.get(\"stableCount\") || 0;\nlet previousChangeWeight = flow.get(\"previousChangeWeight\");\n\n\n// ==========================\n// FIRST READING\n// ==========================\n\nif (lastWeight === undefined) {\n\n    flow.set(\"lastWeight\", weight);\n\n    msg.payload = Number((savedTotal + weight).toFixed(2));\n\n    return msg;\n}\n\n\n// ==========================\n// NORMAL OPERATION\n// ==========================\n\nif (!changingBag) {\n\n    let difference = weight - lastWeight;\n\n    // Detect a large downward change\n    if (difference <= -minDump) {\n\n        // Bag removal has started\n        changingBag = true;\n\n        // Remember the weight immediately before removal\n        oldBagWeight = lastWeight;\n\n        flow.set(\"changingBag\", true);\n        flow.set(\"oldBagWeight\", oldBagWeight);\n\n        flow.set(\"stableCount\", 0);\n        flow.set(\"previousChangeWeight\", weight);\n\n        // Keep displaying the old cumulative total\n        msg.payload = Number(\n            (savedTotal + oldBagWeight).toFixed(2)\n        );\n\n        return msg;\n    }\n\n    // Normal reading\n    flow.set(\"lastWeight\", weight);\n\n    msg.payload = Number(\n        (savedTotal + weight).toFixed(2)\n    );\n\n    return msg;\n}\n\n\n// ==========================\n// BAG IS CURRENTLY CHANGING\n// ==========================\n\nif (changingBag) {\n\n    // Compare current reading to previous reading\n    // during the bag change\n    if (previousChangeWeight !== undefined &&\n        Math.abs(weight - previousChangeWeight) <= stableTolerance) {\n\n        stableCount++;\n\n    } else {\n\n        stableCount = 0;\n    }\n\n    flow.set(\"stableCount\", stableCount);\n    flow.set(\"previousChangeWeight\", weight);\n\n\n    // ==========================\n    // NEW BAG HAS STABILIZED\n    // ==========================\n\n    if (stableCount >= stableReadingsNeeded) {\n\n        // Add completed bag to permanent total\n        savedTotal += oldBagWeight;\n\n        flow.set(\"savedTotal\", savedTotal);\n\n        // New stable reading becomes current bag weight\n        flow.set(\"lastWeight\", weight);\n\n        // Exit bag-changing mode\n        flow.set(\"changingBag\", false);\n        flow.set(\"stableCount\", 0);\n        flow.set(\"previousChangeWeight\", undefined);\n\n        msg.payload = Number(\n            (savedTotal + weight).toFixed(2)\n        );\n\n        return msg;\n    }\n\n\n    // While bag is being removed, freeze display\n    msg.payload = Number(\n        (savedTotal + oldBagWeight).toFixed(2)\n    );\n\n    return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 480,
        "wires": [
            [
                "8f359317fbbf4864",
                "8ef5b70f03b4f687"
            ]
        ]
    },
    {
        "id": "3a0ce7ee5551d681",
        "type": "function",
        "z": "3b9534016f669eca",
        "d": true,
        "name": "Bags Changed",
        "func": "let bagCount = flow.get(\"bagCount\") || 0;\nbagCount += 1;\n\nflow.set(\"bagCount\", bagCount);\nflow.set(\"lastAcceptedWeight\", 0);\n\nmsg.payload = bagCount;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
