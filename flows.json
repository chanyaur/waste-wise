    },
    {
        "id": "7bea578654a0806e",
        "type": "function",
        "z": "3b9534016f669eca",
        "name": "End Day",
        "func": "let total = flow.get(\"dailyTotal\") || 0;\nlet bags = flow.get(\"bagCount\") || 0;\n\nlet report = {\n    date: new Date().toLocaleDateString(),\n    time: new Date().toLocaleTimeString(),\n    dailyTotal: total.toFixed(2),\n    bagCount: bags,\n    event: \"end_of_day\"\n};\n\nflow.set(\"dailyTotal\", 0);\nflow.set(\"bagCount\", 0);\nflow.set(\"lastAcceptedWeight\", 0);\nflow.set(\"bagsChanged\", 0);\n\nlet reportMsg = {\n    payload: report\n};\n\nlet totalResetMsg = {\n    payload: \"0.00\"\n};\n\nlet bagResetMsg = {\n    payload: 0\n};\n\nreturn [\n    reportMsg,\n    totalResetMsg,\n    bagResetMsg\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
